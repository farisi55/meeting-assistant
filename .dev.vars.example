# Salin file ini jadi .dev.vars (sudah di-gitignore) dan isi nilai asli.
# .dev.vars TIDAK PERNAH di-commit — persis seperti .env di n8n/9router.

AUTH_ENABLED=false

OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
SAMBANOVA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Hanya perlu diisi kalau AUTH_ENABLED=true.
# Token acak tinggi-entropi: buat dengan `openssl rand -hex 32`
# (atau `uuidgen`), lalu pakai nilai yang sama di localStorage frontend
# (key: meeting-assistant.auth-token) — lihat README §Konfigurasi.
BASIC_AUTH_TOKEN=

# Opsional — override batas waktu upstream dalam ms (Task #013).
# Bawaan: CHAT_TIMEOUT_MS=30000 (chat), TRANSCRIBE_TIMEOUT_MS=30000 (STT).
# CHAT_TIMEOUT_MS=30000
# TRANSCRIBE_TIMEOUT_MS=30000
