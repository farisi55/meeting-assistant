# @cloudflare/vitest-pool-workers menyebabkan npm's arborist crash
# ("Cannot read properties of null (reading 'edgesOut')") saat resolusi
# peer-dependency biasa -- reproducible, terverifikasi 2026-09-24 dengan
# npm 10.9.7 + vitest 4.1.11 + @cloudflare/vitest-pool-workers 0.22.0.
# legacy-peer-deps menghindarinya; hasil akhir vitest tetap ter-dedupe
# benar ke satu versi (diverifikasi via `npm ls vitest`).
legacy-peer-deps=true
